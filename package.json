{
  "name": "shortlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup-db.mts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
