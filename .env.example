# --- Core ---
# MongoDB connection string. Atlas (mongodb+srv://...), a self-hosted server, or local. Replace this
# with your own once the database exists; the app creates its indexes on first connect.
MONGODB_URI=mongodb://localhost:27017
# Database name inside that server.
MONGODB_DB=shortlist
# Public URL of the app, used in email links and payment return URLs.
APP_URL=http://localhost:3000
# Search indexing is disabled automatically on localhost. Leave blank for that safe default, set false on previews/staging, or true only on the canonical production deployment.
SEO_INDEXING_ENABLED=
# Optional ownership tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# How many proxies sit between the internet and this app (Vercel or one load balancer = 1, a CDN in front of that = 2).
# Used to find the real client IP for rate limits. Set 0 if nothing is in front: the IP header is then ignored.
TRUSTED_PROXY_HOPS=1
# Protects /api/cron-job/* (the URL cron-job.org calls). Long and random: openssl rand -hex 32
CRON_JOB_SECRET=    

# --- Legal pages (shown on /terms, /privacy, /refund; payment providers may review these) ---
LEGAL_OPERATOR_NAME=Your Name or Business Name
LEGAL_COUNTRY=Nepal
SUPPORT_EMAIL=support@yourdomain.com

# --- AI via Anthropic (https://console.anthropic.com). Without a key, plain-code fallbacks run: they work, but tailoring only reorders. ---
ANTHROPIC_API_KEY=
# Reading CVs and job posts uses a fast, cheap model; writing (tailoring, letters, feedback) uses a stronger one.
# Each variable takes ONE Claude model id or a COMMA-SEPARATED LIST. Models are tried in order: a rate limit (429),
# overload or server error (5xx), timeout or unusable answer moves on to the next, and only when all fail does the
# app use its plain-code fallback. Leave both unset to get these defaults:
AI_READ_MODEL=claude-haiku-5-5,claude-sonnet-5-5
AI_WRITE_MODEL=claude-sonnet-5-5,claude-opus-5-5
# Only set this to route through a proxy or gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Email via https://resend.com (confirmations, password resets, follow-up reminders) ---
RESEND_API_KEY=
EMAIL_FROM=Shortlist Job Radar <hello@yourdomain.com>
# Without RESEND_API_KEY, emails are printed to the console in development,
# or written to this file (JSON lines) when it is set. Tests use it.
EMAIL_DEV_OUTBOX=

# --- Job Discovery Agent ---
# Public employer boards to monitor. Format: provider:board=Company name, separated by commas.
# Providers: greenhouse, lever, ashby, workable, smartrecruiters, recruitee. The board is the company's name in its
# careers URL: boards.greenhouse.io/acme -> greenhouse:acme, jobs.lever.co/acme -> lever:acme, jobs.ashbyhq.com/linear
# -> ashby:linear, apply.workable.com/huggingface -> workable:huggingface, jobs.smartrecruiters.com/BoschGroup ->
# smartrecruiters:BoschGroup (case matters), bunq.recruitee.com -> recruitee:bunq.
# Example: greenhouse:acme=Acme,ashby:linear=Linear,workable:huggingface=Hugging Face
JOB_SOURCE_BOARDS=
# Public remote-job feeds (many employers each). Names: remotive, jobicy, himalayas, remoteok, arbeitnow, or all.
# Each allows this use if Shortlist Job Radar links back to the job on its site and names it as the source (the Radar does both).
# LinkedIn and Nepal job portals such as MeroJob forbid automated reading, so they can't be added here.
JOB_SOURCE_FEEDS=
# Web Push uses a VAPID key pair. Generate once with: npx web-push generate-vapid-keys
# The public key is intentionally available to the browser. Keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI required by VAPID, normally a mailto address owned by the operator.
VAPID_SUBJECT=mailto:support@yourdomain.com

# --- Payments: Freemius (monthly and yearly subscriptions) ---
# Everything below is a SERVER secret or id. None of it may ever go in a NEXT_PUBLIC_ variable.
# Webhook URL to register in Freemius:  https://YOUR_DOMAIN/api/webhooks/freemius
#
# "sandbox" uses Freemius's test checkout (test cards, no real money) and only accepts sandbox purchases.
# "production" uses live checkout and REJECTS sandbox purchases. Switch only when you go live.
FREEMIUS_MODE=sandbox
# Developer Dashboard -> your product -> Settings -> Keys (Product ID, Public Key, Secret Key), and your API key
# from the Developer Dashboard's API / Keys page (used as the bearer credential).
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
# Developer Dashboard -> your product -> Plans: the numeric ID of the paid plan, and the ID of each pricing record
# (the monthly price and the yearly price) inside that plan.
FREEMIUS_PLAN_ID=
FREEMIUS_PRICING_ID_MONTHLY=
FREEMIUS_PRICING_ID_YEARLY=
# Display-only text for the pricing page, for example "USD 9 / month". Real prices come from Freemius at checkout.
# Do not start a value with a bare $: .env expands "$9" like a variable and drops it. Write "USD 9" instead.
BILLING_PRICE_LABEL_MONTHLY=
BILLING_PRICE_LABEL_YEARLY=
# Days of paid access kept after the paid-through date while a failed renewal is being retried (0 to 60).
BILLING_GRACE_DAYS=3
# What a suspended subscription gets: "none" (no access) or "grace" (the grace period above).
BILLING_SUSPENDED_ACCESS=none
# Tests and local runs only: leave unset in real deployments. "1" stops all calls to Freemius's API.
# FREEMIUS_SKIP_API_SYNC=
